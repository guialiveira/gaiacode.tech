{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.gaiacode.tech"
        }
      ],
      "destination": "https://gaiacode.tech/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/servicos", "destination": "/servicos.html" },
    { "source": "/cases", "destination": "/cases.html" },
    { "source": "/contato", "destination": "/contato.html" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
